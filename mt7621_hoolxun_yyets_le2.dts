// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
// HOELXUN YYETs-LE2 (MT7621AT + 32MB SPI NOR + 2x MT7612E)
// 基于上传固件 DTB + factory.bin 备份定稿
// 已确认: 512MB DDR3 / eeprom#1@factory 0x0 (MAC ..61) / eeprom#2@factory 0x8000 (MAC ..62)
//         LAN MAC @factory 0x2c (..5F) / WAN MAC @factory 0x32 (..60)
// 编译配套: mt7621.mk 设备定义 DEVICE_PACKAGES 需含
//   板载/USB无线: kmod-mt76x2 kmod-rtl8188eu kmod-rt2800-usb
//   USB: kmod-usb3 kmod-usb2 kmod-usb-storage kmod-fs-exfat kmod-fs-vfat
//        kmod-fs-ext4 kmod-fs-ntfs3 block-mount usbutils
//   手机/随身WiFi: kmod-usb-net kmod-usb-net-rndis kmod-usb-net-cdc-ether
//        kmod-usb-net-cdc-eem kmod-usb-net-cdc-mbim kmod-usb-net-ipheth usb-modeswitch
//   中继: relayd
//   抓包: aircrack-ng tcpdump horst iw
//   VPN: kmod-wireguard wireguard-tools luci-proto-wireguard
//   加速: kmod-nf-flow（MT7621 无硬件HNAT，仅软件flowtable）

/dts-v1/;

#include "mt7621.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "hoolxun,yyets-le2", "mediatek,mt7621-soc";
	model = "HOELXUN YYETs-LE2";

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		label-mac-device = &gmac0;
	};

	// 512MB 内存不写 memory 节点，由 MT7621 芯片 mem_detect 自动检测（与官方 325 个 mt7621 设备一致）
	// 注意：root #address-cells=1，若写 reg=<0x0 0x0 0x0 0x20000000> 会解析成两对(addr,size)导致 syscon panic

	leds {
		compatible = "gpio-leds";

		led_status: status {
			label = "yyets-le2:blue:status";
			gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;

				compatible = "nvmem-cells";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_factory_2c: macaddr@2c {
					reg = <0x2c 0x6>; // LAN MAC 0C:EF:AF:B3:04:5F
				};

				macaddr_factory_32: macaddr@32 {
					reg = <0x32 0x6>; // WAN MAC 0C:EF:AF:B3:04:60
				};
			};

			partition@50000 {
				label = "firmware";
				reg = <0x50000 0x1fb0000>;
			};
		};
	};
};

&pcie0 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt7612e";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x0>;      // eeprom#1, MAC 0C:EF:AF:B3:04:61
	};
};

&pcie1 {
	status = "okay";

	wifi@0,0 {
		compatible = "mediatek,mt7612e";
		reg = <0x0000 0 0 0 0>;
		mediatek,mtd-eeprom = <&factory 0x8000>;   // eeprom#2, MAC 0C:EF:AF:B3:04:62
	};
};

&gmac0 {
	status = "okay";

	nvmem-cells = <&macaddr_factory_2c>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";

	nvmem-cells = <&macaddr_factory_32>;
	nvmem-cell-names = "mac-address";
};
